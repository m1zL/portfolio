---
import { siPhp, siPython, siLaravel, siMysql, siRedis, siOpensearch, siGitlab, siGit } from 'simple-icons';
import {
  skills,
  CATEGORY_LABELS,
  CATEGORY_ORDER,
  LEVEL_RANK,
  LEVEL_MAX,
  LEVEL_ORDER,
  LEVEL_DESCRIPTION,
  type SkillCategory,
} from '../../data/skills';

interface IconData {
  path: string;
  hex: string;
}

// simple-icons にあるロゴ（ビルド時にインライン SVG にする）
const iconMap: Record<string, IconData> = {
  PHP: { path: siPhp.path, hex: siPhp.hex },
  Python: { path: siPython.path, hex: siPython.hex },
  Laravel: { path: siLaravel.path, hex: siLaravel.hex },
  MySQL: { path: siMysql.path, hex: siMysql.hex },
  Redis: { path: siRedis.path, hex: siRedis.hex },
  OpenSearch: { path: siOpensearch.path, hex: siOpensearch.hex },
  'GitLab CI/CD': { path: siGitlab.path, hex: siGitlab.hex },
  Git: { path: siGit.path, hex: siGit.hex },
};

// simple-icons にロゴが無いスキルは、文字のバッジで代用する
const badgeText: Record<string, string> = {
  SQL: 'SQL',
  AWS: 'AWS',
  PHPUnit: 'PU',
  Pest: 'Pe',
};

const categoryStyle: Record<SkillCategory, { dot: string; badge: string }> = {
  language: { dot: 'bg-emerald-500', badge: 'bg-emerald-50 text-emerald-700' },
  framework: { dot: 'bg-blue-500', badge: 'bg-blue-50 text-blue-700' },
  database: { dot: 'bg-purple-500', badge: 'bg-purple-50 text-purple-700' },
  infrastructure: { dot: 'bg-orange-500', badge: 'bg-orange-50 text-orange-700' },
  tool: { dot: 'bg-sky-500', badge: 'bg-sky-50 text-sky-700' },
};

const levels = Array.from({ length: LEVEL_MAX }, (_, i) => i + 1);

// カテゴリ別にグループ化し、featured を先頭に、同レベル内はアルファベット順に並べる
const skillsByCategory = CATEGORY_ORDER.map(category => ({
  category,
  label: CATEGORY_LABELS[category],
  items: skills
    .filter(s => s.category === category)
    .sort((a, b) => {
      if (a.featured !== b.featured) return a.featured ? -1 : 1;
      if (LEVEL_RANK[a.level] !== LEVEL_RANK[b.level]) return LEVEL_RANK[b.level] - LEVEL_RANK[a.level];
      return a.name.localeCompare(b.name);
    }),
})).filter(group => group.items.length > 0);
---

<section class="py-16 px-4 bg-gray-50" aria-labelledby="skills-heading">
  <div class="max-w-4xl mx-auto">
    <h2
      id="skills-heading"
      class="text-3xl font-semibold text-gray-800 mb-6 text-center animate-on-scroll"
    >
      Skills &amp; Technologies
    </h2>

    <!-- 凡例 -->
    <div class="mb-10 animate-on-scroll">
      <p class="text-center text-xs text-gray-500 mb-2">習熟度（3 段階）　カードを開くと詳細を表示</p>
      <ul class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center sm:justify-center gap-x-6 gap-y-1.5 text-xs text-gray-500 max-w-fit mx-auto">
        {LEVEL_ORDER.map(level => (
          <li class="flex items-center gap-2">
            <span class="flex gap-0.5" aria-hidden="true">
              {levels.map(n => (
                <span class={`w-2 h-2 rounded-full ${n <= LEVEL_RANK[level] ? 'bg-primary' : 'border border-gray-400'}`}></span>
              ))}
            </span>
            <span class="font-medium text-gray-700">{level}</span>
            <span>{LEVEL_DESCRIPTION[level]}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col gap-8">
      {skillsByCategory.map(group => (
        <div>
          <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-500 uppercase tracking-widest mb-3 animate-on-scroll">
            <span class={`w-2 h-2 rounded-full ${categoryStyle[group.category].dot}`} aria-hidden="true"></span>
            {group.label}
          </h3>
          <ul class="grid grid-cols-1 min-[400px]:grid-cols-2 md:grid-cols-3 gap-3 items-start" role="list">
            {group.items.map((skill, i) => {
              const icon = iconMap[skill.name];
              const rank = LEVEL_RANK[skill.level];
              const hasDetail = Boolean(skill.description) || (skill.canDo?.length ?? 0) > 0;
              return (
                <li class="animate-on-scroll" data-delay={i * 40}>
                  <details class="group bg-white rounded-xl border border-gray-200 shadow-sm open:shadow-md open:border-primary/50 transition-shadow">
                    <summary class="flex items-center gap-3 p-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-xl hover:bg-gray-50 group-open:hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                      {icon ? (
                        <span class="w-10 h-10 shrink-0 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center" aria-hidden="true">
                          <svg viewBox="0 0 24 24" class="w-6 h-6" style={`fill: #${icon.hex}`}>
                            <path d={icon.path} />
                          </svg>
                        </span>
                      ) : (
                        <span
                          class={`w-10 h-10 shrink-0 rounded-lg border border-gray-100 flex items-center justify-center text-xs font-bold tracking-tight ${categoryStyle[skill.category].badge}`}
                          aria-hidden="true"
                        >
                          {badgeText[skill.name] ?? skill.name.slice(0, 2)}
                        </span>
                      )}
                      <span class="flex-1 min-w-0">
                        <span class="block font-semibold text-gray-800 leading-tight truncate">{skill.name}</span>
                        <span class="mt-1 flex items-center gap-2 text-xs text-gray-500">
                          <span class="flex gap-0.5" aria-hidden="true">
                            {levels.map(n => (
                              <span class={`w-2 h-2 rounded-full ${n <= rank ? 'bg-primary' : 'border border-gray-400'}`}></span>
                            ))}
                          </span>
                          <span><span class="sr-only">習熟度 </span>{skill.level}</span>
                          <span aria-hidden="true">·</span>
                          <span><span class="sr-only">経験 </span>{skill.yearsOfExperience}年</span>
                        </span>
                      </span>
                      {hasDetail && (
                        <svg
                          class="w-4 h-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180 motion-reduce:transition-none"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      )}
                    </summary>
                    {hasDetail && (
                      <div class="mx-3 pb-3 border-t border-gray-100 text-sm text-gray-600">
                        {skill.description && <p class="mt-2 leading-relaxed">{skill.description}</p>}
                        {skill.canDo && skill.canDo.length > 0 && (
                          <>
                            <p class="mt-3 text-xs font-semibold text-teal-700">できること</p>
                            <ul class="mt-1 space-y-1">
                              {skill.canDo.map(item => (
                                <li class="flex items-start gap-1.5">
                                  <span class="text-teal-700 shrink-0" aria-hidden="true">·</span>
                                  {item}
                                </li>
                              ))}
                            </ul>
                          </>
                        )}
                      </div>
                    )}
                  </details>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
